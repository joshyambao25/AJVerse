rules_version = '2';

// OurNest security rules: only the two members of a couple can see
// or change that couple's data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Each person's profile. Readable by signed-in users so partners can see each other's name.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Invite code -> couple lookup.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /couples/{coupleId} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Members can edit settings (anniversary, currency)...
      allow update: if signedIn() && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members;

      // ...and a second person may join once, adding only themselves.
      allow update: if signedIn()
                    && resource.data.members.size() == 1
                    && !(request.auth.uid in resource.data.members)
                    && request.resource.data.members.size() == 2
                    && request.resource.data.members.hasAll(resource.data.members)
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      allow delete: if false;

      // Each person can only write their own location.
      match /locations/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == uid;
      }

      // Transactions, budgets, goals, bills, updates, lists.
      match /{sub}/{docId} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && sub != 'locations';
      }
    }
  }
}
